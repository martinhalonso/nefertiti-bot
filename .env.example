# Número del celular administrador (segundo celular, sin + ni espacios, con código de país)
ADMIN_PHONE=5491112345678

# Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=

# Datos de la seña / señal de pago
SEÑA_MONTO=500
SEÑA_CBU=0000000000000000000000
SEÑA_ALIAS=mi.alias.mp

# Puerto del servidor Express
PORT=3000

# Zona horaria del servidor (importante para cálculo de fechas)
TZ=America/Argentina/Buenos_Aires
